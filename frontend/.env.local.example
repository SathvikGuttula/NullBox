# Where the backend is. Both default to localhost:8000 if unset, which is what
# start.ps1 launches, so you only need this file if you moved the backend.
#
# Copy to .env.local and edit. Next.js only exposes variables prefixed
# NEXT_PUBLIC_ to browser code, so the names matter.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
