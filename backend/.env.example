# Copy to backend/.env and edit. Nothing here is secret today - there is no
# authentication in front of this API - but that is a limitation, not a design.

APP_NAME=VoxShield
APP_ENV=development
DEBUG=true

# Optional. The API starts and works fully without Postgres; persistence is the
# only thing that degrades, and nothing currently writes to it anyway.
DATABASE_URL=postgresql+asyncpg://voxshield:voxshield@localhost:5432/voxshield

# --- CORS ------------------------------------------------------------------
#
# Which origins may call this API from a browser. The local dev server is
# covered by default. Add a deployed frontend explicitly:
#
#   CORS_ORIGINS=http://localhost:3000,https://voxshield.vercel.app
#
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vercel gives every preview deployment its own hostname, so an exact list
# breaks on every push. Uncomment to allow them all:
#
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# --- audio -----------------------------------------------------------------
RISK_UPDATE_INTERVAL_MS=500
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=2
